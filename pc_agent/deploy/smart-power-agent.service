# Mẫu systemd cho PC Agent (Linux daemon).
#
# Cài đặt:
#   sudo ./install_linux.sh
#
# Yêu cầu: user `smartpower` phải nằm trong nhóm `dialout` để đọc cổng
# serial (/dev/ttyUSB0, /dev/ttyACM0).

[Unit]
Description=Smart Power Outlet - Electronic PC Agent
Documentation=https://github.com/CatKod/Smart_Power_Outlet
After=network.target
Wants=network.target

[Service]
Type=simple
User=smartpower
Group=dialout

WorkingDirectory=/opt/smartpower
ExecStart=/opt/smartpower/venv/bin/python -m pc_agent --no-console-log
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5s
TimeoutStopSec=15s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-power-agent

# Thư mục quản lý do systemd tạo và gán quyền
ConfigurationDirectory=smartpower
StateDirectory=smartpower
LogsDirectory=smartpower

# Biến môi trường cho ứng dụng
Environment=SMARTPOWER_CONFIG_DIR=/etc/smartpower
Environment=SMARTPOWER_DATA_DIR=/var/lib/smartpower
Environment=SMARTPOWER_LOG_DIR=/var/log/smartpower
Environment=PYTHONUNBUFFERED=1

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true

# Quyền truy cập thiết bị serial
DeviceAllow=/dev/ttyUSB0 rw
DeviceAllow=/dev/ttyUSB1 rw
DeviceAllow=/dev/ttyACM0 rw

[Install]
WantedBy=multi-user.target
