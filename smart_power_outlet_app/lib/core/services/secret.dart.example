/// MQTT credentials — MẪU (template). KHÔNG commit file thật.
///
/// Cách dùng:
///   1. Copy file này thành `secret.dart` cạnh bên:
///        cp lib/core/services/secret.dart.example lib/core/services/secret.dart
///   2. Điền credential thật.
///   3. `secret.dart` đã nằm trong `smart_power_outlet_app/.gitignore`
///      (`*lib/core/services/secret.dart`) → KHÔNG BAO GIỜ bị commit.
///
/// LƯU Ý AN TOÀN: credential từng được commit vào repo **public**
/// (`github.com/CatKod/Smart_Power_Outlet`). Hãy ĐỔI MẬT KHẨU trên broker.
// ignore_for_file: constant_identifier_names

const String mqttHost = 'mqtt.toolhub.app';
const int mqttPort = 1883;
const String mqttUsername = 'YOUR_MQTT_USERNAME';
const String mqttPassword = 'YOUR_MQTT_PASSWORD';
