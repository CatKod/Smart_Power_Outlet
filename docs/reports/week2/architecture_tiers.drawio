<mxGraphModel adaptiveColors="auto" dx="1280" dy="690" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="690" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Smart Power Outlet — Phân tầng kiến trúc 3 thành phần" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1F4E79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="700" height="40" as="geometry" /></mxCell><mxCell id="z1" value="MÁY CHỦ GIÁM SÁT TRONG TỦ RACK" style="swimlane;html=1;rounded=1;arcSize=6;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontSize=13;fontStyle=1;fontColor=#1B1F24;startSize=30;horizontal=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="400" height="240" as="geometry" /></mxCell><mxCell id="z2" value="MÁY CHỦ WEB" style="swimlane;html=1;rounded=1;arcSize=6;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontSize=13;fontStyle=1;fontColor=#1B1F24;startSize=30;horizontal=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="300" height="240" as="geometry" /></mxCell><mxCell id="z3" value="VI ĐIỀU KHIỂN" style="swimlane;html=1;rounded=1;arcSize=6;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontSize=13;fontStyle=1;fontColor=#1B1F24;startSize=30;horizontal=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="340" height="240" as="geometry" /></mxCell><mxCell id="z4" value="THIẾT BỊ ĐO ĐIỆN" style="swimlane;html=1;rounded=1;arcSize=6;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontSize=13;fontStyle=1;fontColor=#1B1F24;startSize=30;horizontal=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="320" height="150" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;1. ELECTRONIC PC AGENT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Windows Service / systemd daemon&lt;/font&gt;&lt;br&gt;&lt;font st