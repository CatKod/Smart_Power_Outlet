/**
 * @file secrets.h
 * @brief MQTT credentials — MẪU (template). KHÔNG commit file thật.
 *
 * Cách dùng:
 *   cp main/secrets.h.example main/secrets.h
 *   rồi điền credential thật vào `main/secrets.h`.
 *
 * `main/secrets.h` đã nằm trong `.gitignore` (`**/secrets.h`) → không bị commit.
 *
 * LƯU Ý AN TOÀN: credential từng được commit vào repo **public**
 * (`github.com/CatKod/Smart_Power_Outlet`). Hãy ĐỔI MẬT KHẨU trên broker.
 */
#pragma once

#define MQTT_HOST     "mqtt.toolhub.app"
#define MQTT_PORT     1883
#define MQTT_USERNAME "YOUR_MQTT_USERNAME"
#define MQTT_PASSWORD "YOUR_MQTT_PASSWORD"
