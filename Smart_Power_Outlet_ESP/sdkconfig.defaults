# =========================================================
# CẤU HÌNH MẶC ĐỊNH CHO MẠCH JC-ESP32P4-M3 (P4 + C6 HOSTED)
# =========================================================

# 1. CẤU HÌNH CHIP ĐÍCH VÀ KIẾN TRÚC MẠNG
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y

# Ép hệ thống nhận diện đúng module Wi-Fi phụ trợ là ESP32-C6 (Không phải H2)
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"

# 2. FIX LỖI THIẾU BIẾN BỘ ĐỆM (Khắc phục triệt để lỗi undeclared)
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER=y
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_WIFI_RMT_ESPNOW_MAX_ENCRYPT_NUM=7

# 3. GIAO TIẾP VẬT LÝ P4 <-> C6 (Sử dụng chuẩn SDIO tốc độ cao)
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SPI_HOST_INTERFACE=n

# 4. BẬT SOFTAP ĐỂ SỬ DỤNG CHẾ ĐỘ AP (CAPTIVE PORTAL PROVISIONING)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# 5. TỐI ƯU HÓA RTOS VÀ BỘ NHỚ CHO DỰ ÁN IOT
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096