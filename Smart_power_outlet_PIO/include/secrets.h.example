/**
 * @file secrets.h
 * @brief MQTT credentials — MẪU (template). KHÔNG commit file thật.
 *
 * Cách dùng:
 *   1. Copy file này thành `secrets.h` cạnh bên:
 *        cp include/secrets.h.example include/secrets.h
 *        (Windows: copy include\secrets.h.example include\secrets.h)
 *   2. Điền credential thật vào `secrets.h`.
 *   3. `include/secrets.h` đã nằm trong `.gitignore` (`**/secrets.h`) nên
 *      KHÔNG BAO GIỜ bị commit — kể cả khi bạn lỡ `git add -A`.
 *
 * Vì sao cần template:
 *   File `secrets.h` gốc đã từng được commit và push lên repo **public**
 *   (`github.com/CatKod/Smart_Power_Outlet`) → credential MQTT bị lộ.
 *   Lịch sử git đã được làm sạch bằng `git filter-repo`, nhưng template này
 *   tồn tại để lần sau không ai vô tình commit lại.
 *
 * LƯU Ý AN TOÀN: nếu bạn từng push credential này lên repo public,
 * hãy ĐỔI MẬT KHẨU trên broker. Xoá khỏi git KHÔNG làm credential cũ mất hiệu lực.
 */
#pragma once

// ---------------------------------------------------------------------------
// MQTT broker
// ---------------------------------------------------------------------------
#define MQTT_HOST     "mqtt.toolhub.app"
#define MQTT_PORT     1883
#define MQTT_USERNAME "YOUR_MQTT_USERNAME"
#define MQTT_PASSWORD "YOUR_MQTT_PASSWORD"
